APP_NAME=Assistente RAG de Orientacao Pre-Procedimento
API_HOST=0.0.0.0
API_PORT=8000

RAW_DATA_DIR=data/raw
SAMPLE_DATA_DIR=data/samples
VECTOR_STORE_DIR=data/vector_store
CHROMA_COLLECTION=clinic_procedure_docs

EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=4

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_KEEP_ALIVE=10m
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=120
LLM_NUM_CTX=2048
LLM_NUM_PREDICT=350
LLM_NUM_GPU=

WHATSAPP_PROVIDER=chatpro
CHATPRO_BASE_URL=https://v5.chatpro.com.br
CHATPRO_INSTANCE_ID=
CHATPRO_TOKEN=
CHATPRO_RESPOND_FROM_ME=false
CHATPRO_BOT_PREFIX=Assistente:
CHATPRO_FROM_ME_TRIGGER=!bot

NGROK_AUTHTOKEN=
